# Cloudinary Configuration
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# MongoDB Atlas Connection String
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/fashion_freaks?retryWrites=true&w=majority

# Admin Upload Secret Key
UPLOAD_PASSWORD=your_admin_secret_key

# Groq API Key for AI Customer Support Chatbot
GROQ_API_KEY=your_groq_api_key

# Server Port
PORT=5000
